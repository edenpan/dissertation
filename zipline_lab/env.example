# B线 zipline bundle 的 stockdb 只读连接(拷成 dissertation/.env 并填密码,.env 已 gitignore)
#
# 账号约定:最小权账号 altas(只有 stockdb 的 SELECT),不用 eden 管理员账号。
# 授权(eden 手工执行一次):GRANT SELECT ON stockdb.* TO 'altas'@'localhost';
#
# 用法(zipline CLI 是独立进程,必须先在 shell 导出):
#   set -a; source .env; set +a
#   .venv-zipline/bin/zipline ingest -b stockdb
DATA_DB_HOST=127.0.0.1
DATA_DB_PORT=3306
DATA_DB_USER=altas
DATA_DB_PASSWORD=
DATA_DB_NAME=stockdb
